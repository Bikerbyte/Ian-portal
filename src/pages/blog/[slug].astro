---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../utils/paths";
import { isPublicTag, postUrl, readingMinutes, termSlug } from "../../utils/content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = (await getCollection("blog")).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const index = allPosts.findIndex((entry) => entry.id === post.id);
const previousPost = index > 0 ? allPosts[index - 1] : null;
const nextPost = index >= 0 && index < allPosts.length - 1 ? allPosts[index + 1] : null;
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const formattedDate = post.data.date.toLocaleDateString("zh-TW", { year: "numeric", month: "long", day: "numeric" });
const estReadingTime = readingMinutes(post.body ?? "");
const publicTags = post.data.tags.filter(isPublicTag);
const seriesPosts = post.data.series
  ? allPosts
      .filter((entry) => entry.data.series === post.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999) || a.data.date.getTime() - b.data.date.getTime())
  : [];
---

<BaseLayout title={post.data.title} description={post.data.excerpt} image={post.data.cover}>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <section class="section post-section">
    <div class="container post-layout">
      <article class="post-article">
        <div class="post-meta">
          <a href={withBase(`/categories/${termSlug(post.data.category)}/`)}>{post.data.category}</a>
          <span>發表於 {formattedDate}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-lead">{post.data.excerpt}</p>
        <div class="post-content">
          <Content />
        </div>
      </article>

      <aside class="post-sidebar" data-post-tabs>
        <div class="post-sidebar-tabs" role="tablist" aria-label="文章側欄">
          <button class="post-sidebar-tab is-active" type="button" role="tab" id="post-tab-info" aria-controls="post-panel-info" aria-selected="true" data-post-tab="info">
            資訊
          </button>
          {seriesPosts.length > 1 && (
            <button class="post-sidebar-tab" type="button" role="tab" id="post-tab-series" aria-controls="post-panel-series" aria-selected="false" data-post-tab="series">
              系列
            </button>
          )}
          {tocHeadings.length > 0 && (
            <button class="post-sidebar-tab" type="button" role="tab" id="post-tab-toc" aria-controls="post-panel-toc" aria-selected="false" data-post-tab="toc">
              目錄
            </button>
          )}
          <button class="post-sidebar-tab" type="button" role="tab" id="post-tab-nav" aria-controls="post-panel-nav" aria-selected="false" data-post-tab="nav">
            上下篇
          </button>
        </div>

        <div class="post-sidebar-panels">
          <section class="sidebar-card post-stats-card post-tab-panel is-active" id="post-panel-info" role="tabpanel" aria-labelledby="post-tab-info" data-post-panel="info">
            <p class="sidebar-title">文章資訊</p>
            <dl class="post-stats">
              <div>
                <dt>分類</dt>
                <dd><a href={withBase(`/categories/${termSlug(post.data.category)}/`)}>{post.data.category}</a></dd>
              </div>
              <div>
                <dt>日期</dt>
                <dd>{formattedDate}</dd>
              </div>
              <div>
                <dt>閱讀時間</dt>
                <dd>{estReadingTime} 分鐘</dd>
              </div>
            </dl>
            <div class="tag-list sidebar-tags">
              {publicTags.map((tag) => (
                <a class="tag" href={withBase(`/tags/${termSlug(tag)}/`)}>{tag}</a>
              ))}
            </div>
          </section>

          {seriesPosts.length > 1 && (
            <nav class="sidebar-card series-card post-tab-panel" id="post-panel-series" role="tabpanel" aria-labelledby="post-tab-series" aria-label="系列文章" data-post-panel="series">
              <p class="sidebar-title">{post.data.series}</p>
              <div class="series-links">
                {seriesPosts.map((entry) => (
                  <a class:list={[entry.id === post.id && "is-current"]} href={withBase(postUrl(entry.id))}>
                    <span>{entry.data.seriesOrder ?? seriesPosts.indexOf(entry) + 1}</span>
                    {entry.data.title}
                  </a>
                ))}
              </div>
            </nav>
          )}

          {tocHeadings.length > 0 && (
            <nav class="sidebar-card toc-card post-tab-panel" id="post-panel-toc" role="tabpanel" aria-labelledby="post-tab-toc" aria-label="文章目錄" data-post-panel="toc">
              <p class="sidebar-title">文章目錄</p>
              <div class="toc-links">
                {tocHeadings.map((heading) => (
                  <a class:list={[`toc-depth-${heading.depth}`]} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                ))}
              </div>
            </nav>
          )}

          <nav class="sidebar-card post-nav-card post-tab-panel" id="post-panel-nav" role="tabpanel" aria-labelledby="post-tab-nav" aria-label="上下篇" data-post-panel="nav">
            <p class="sidebar-title">繼續閱讀</p>
            <div class="post-nav-links">
              {previousPost && <a href={withBase(postUrl(previousPost.id))}><span>上一篇</span>{previousPost.data.title}</a>}
              {nextPost && <a href={withBase(postUrl(nextPost.id))}><span>下一篇</span>{nextPost.data.title}</a>}
              <a href={withBase("/blog/")}><span>列表</span>回文章列表</a>
            </div>
          </nav>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll("[data-post-tabs]").forEach((tabsRoot) => {
    const tabButtons = Array.from(tabsRoot.querySelectorAll("[data-post-tab]"));
    const panels = Array.from(tabsRoot.querySelectorAll("[data-post-panel]"));

    function selectTab(tabName: string) {
      tabButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) {
          return;
        }

        const active = button.dataset.postTab === tabName;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-selected", String(active));
      });

      panels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) {
          return;
        }

        const active = panel.dataset.postPanel === tabName;
        panel.classList.toggle("is-active", active);
      });
    }

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (button instanceof HTMLButtonElement) {
          selectTab(button.dataset.postTab ?? "info");
        }
      });
    });
  });
</script>
